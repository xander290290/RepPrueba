---
import SiteLayout from "../components/SiteLayout.astro";
---

<SiteLayout
  title="Contacto"
  description="Información de contacto del IES Ramón Arcas Meca."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">IES Ramón Arcas Meca</p>
      <h1>Contacto</h1>
      <p>Información para contactar con el centro educativo.</p>
    </div>
  </section>

  <section class="content-section contact-page">
    <article class="info-card">
      <h2>Centro educativo</h2>
      <p>IES Ramón Arcas Meca</p>
      <p>Totana, Murcia</p>
      <p>Los datos de contacto se añadirán tras su validación.</p>
    </article>
  </section>
</SiteLayout>

<style>
  .contact-page .info-card {
    max-width: 680px;
    margin-inline: auto;
  }
</style>
