---
import SiteLayout from "../components/SiteLayout.astro";
---

<SiteLayout
  title="Enseñanzas"
  description="Oferta educativa del IES Ramón Arcas Meca."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">IES Ramón Arcas Meca</p>
      <h1>Enseñanzas</h1>
      <p>Conoce las etapas educativas y la oferta académica del centro.</p>
    </div>
  </section>

  <section class="content-section teachings-page">
    <div class="card-grid">
      <article class="info-card">
        <p class="eyebrow">Etapas educativas</p>
        <h2>Una formación para cada etapa</h2>
        <ul>
          <li>Educación Secundaria Obligatoria</li>
          <li>Bachillerato</li>
          <li>Formación Profesional</li>
        </ul>
      </article>
      <article class="info-card">
        <p class="eyebrow">Oferta académica</p>
        <h2>Materias y opciones</h2>
        <ul>
          <li>Materias optativas</li>
        </ul>
      </article>
    </div>
  </section>
</SiteLayout>

<style>
  .teachings-page .info-card {
    background: linear-gradient(145deg, var(--paper), #eef6f1);
  }
</style>
