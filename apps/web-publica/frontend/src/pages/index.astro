---
import SiteLayout from "../components/SiteLayout.astro";
import { getActivePrograms, getPublishedNews } from "../lib/public-api";

const [news, programs] = await Promise.all([getPublishedNews(3), getActivePrograms()]);
---

<SiteLayout
  title="IES Ramón Arcas Meca"
  description="Información educativa, recursos para las familias y actualidad del IES Ramón Arcas Meca."
>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">IES Ramón Arcas Meca · Totana, Murcia</p>
      <h1>Aprender, convivir y construir futuro</h1>
      <p class="hero-lead">
        Bienvenido a la web del centro. Aquí encontrarás información educativa,
        recursos para las familias y la actualidad de nuestra comunidad.
      </p>
      <a class="button button-light" href="/ensenanzas/">Explora nuestras enseñanzas</a>
    </div>
    <div class="hero-art" aria-hidden="true">
      <span class="art-sun"></span>
      <span class="art-hill art-hill-back"></span>
      <span class="art-hill art-hill-front"></span>
    </div>
  </section>

  <section class="content-section" aria-labelledby="welcome-heading">
    <div class="section-heading">
      <p class="eyebrow">Un centro abierto a su comunidad</p>
      <h2 id="welcome-heading">Te damos la bienvenida</h2>
      <p>Un espacio para conocer el centro, su oferta educativa y la vida de nuestra comunidad.</p>
    </div>
    <div class="card-grid">
      {programs.slice(0, 3).map((program) => (
        <article class="info-card">
          <p class="eyebrow">{program.category}</p>
          <h3>{program.name}</h3>
          <p>{program.description}</p>
          <a class="text-link" href="/programas/">Más información <span aria-hidden="true">→</span></a>
        </article>
      ))}
      {programs.length === 0 && (
        <article class="info-card">
          <h3>Oferta educativa</h3>
          <p>Consulta las enseñanzas que ofrece el centro.</p>
          <a class="text-link" href="/ensenanzas/">Ver enseñanzas <span aria-hidden="true">→</span></a>
        </article>
      )}
    </div>
  </section>

  <section class="content-section" aria-labelledby="news-heading">
    <div class="section-heading">
      <p class="eyebrow">Actualidad del centro</p>
      <h2 id="news-heading">Últimas noticias</h2>
    </div>
    {news.items.length > 0 ? (
      <div class="card-grid">
        {news.items.map((item) => (
          <article class="info-card">
            <p class="eyebrow">{new Date(item.published_at).toLocaleDateString("es-ES")}</p>
            <h3><a href={`/noticias/${item.id}/`}>{item.title}</a></h3>
            <p>{item.summary}</p>
          </article>
        ))}
      </div>
    ) : (
      <p>No hay noticias publicadas en este momento.</p>
    )}
  </section>

  <section class="program-band" aria-labelledby="program-heading">
    <div>
      <p class="eyebrow">Proyectos del centro</p>
      <h2 id="program-heading">Una comunidad que participa y crece</h2>
    </div>
    <a class="button button-outline" href="/programas/">Ver programas y planes</a>
  </section>
</SiteLayout>

<style>
  .hero-content {
    max-width: 1180px;
  }

  .section-heading {
    max-width: 760px;
    margin-inline: auto;
  }
</style>
