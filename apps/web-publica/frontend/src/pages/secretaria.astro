---
import SiteLayout from "../components/SiteLayout.astro";
---

<SiteLayout
  title="Secretaría"
  description="Información sobre atención y trámites administrativos del centro."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">IES Ramón Arcas Meca</p>
      <h1>Secretaría</h1>
      <p>Información para realizar trámites administrativos del centro.</p>
    </div>
  </section>

  <section class="content-section secretary-page">
    <div class="card-grid">
      <article class="info-card">
        <h2>Atención</h2>
        <p>Consulta la información sobre cita previa.</p>
        <a class="text-link" href="#tramites">Ver trámites</a>
      </article>
      <article class="info-card" id="tramites">
        <h2>Trámites</h2>
        <ul>
          <li>Matrícula</li>
          <li>Certificados</li>
          <li>Otros trámites administrativos</li>
        </ul>
      </article>
    </div>
  </section>
</SiteLayout>

<style>
  .secretary-page .info-card {
    scroll-margin-top: 1.5rem;
  }
</style>
